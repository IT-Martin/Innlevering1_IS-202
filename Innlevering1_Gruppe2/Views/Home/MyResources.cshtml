@model IReadOnlyList<Innlevering1_Gruppe2.Models.Entities.Resource>

@{
    ViewData["Title"] = "Mine ressurser";
}

<div class="management-page">
    <div class="management-header">
        <div>
            <p class="eyebrow">MIN KONTO</p>
            <h1>Mine ressurser</h1>
            <p class="text-muted mb-0">Administrer ressursene du har lagt inn.</p>
        </div>
        <a class="btn btn-primary" asp-action="Register">
            <i class="fa-solid fa-box-open" aria-hidden="true"></i> Legg til ressurs
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state card">
            <div class="card-body text-center">
                <div class="empty-state-icon" aria-hidden="true">
                    <i class="fa-solid fa-map-location-dot"></i>
                </div>
                <h2>Du har ingen ressurser ennå</h2>
                <p class="text-muted">Legg inn en ressurs, så kan du endre eller slette den her senere.</p>
                <a class="btn btn-primary" asp-action="Register">Registrer første ressurs</a>
            </div>
        </div>
    }
    else
    {
        <div class="resource-grid">
            @foreach (var resource in Model)
            {
                <article class="resource-card card">
                    <div class="card-body">
                        <div class="resource-card-heading">
                            <div>
                                <span class="status-pill">@resource.verification_status</span>
                                <h2>
                                    <i class="@Innlevering1_Gruppe2.Models.ResourceTypeIcon.For(resource.ResourceType.category_name, resource.resource_name) resource-type-icon" aria-hidden="true"></i>
                                    @resource.resource_name
                                </h2>
                            </div>
                            <span class="resource-type">
                                <i class="@Innlevering1_Gruppe2.Models.ResourceTypeIcon.For(resource.ResourceType.category_name, resource.resource_name)" aria-hidden="true"></i>
                                @resource.ResourceType.category_name
                            </span>
                        </div>

                        <p class="resource-description">
                            @(string.IsNullOrWhiteSpace(resource.description) ? "Ingen beskrivelse lagt til." : resource.description)
                        </p>

                        <div class="resource-meta">
                            <span><strong>Latitude:</strong> @resource.Location.latitude.ToString("F6")</span>
                            <span><strong>Longitude:</strong> @resource.Location.longitude.ToString("F6")</span>
                        </div>

                        <div class="resource-actions">
                            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@resource.resource_id">Endre</a>
                            <form asp-action="Delete" asp-route-id="@resource.resource_id" method="post" onsubmit="return confirm('Vil du slette denne ressursen?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger">Slett</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
