@* Felles temavalg på startsiden og under Min konto. *@
<label class="theme-picker" hidden>
    <i class="fa-regular fa-moon" aria-hidden="true"></i>
    <span class="visually-hidden">Utseende</span>
    <select class="form-select" data-theme-choice>
        <option value="light">Lys</option>
        <option value="dark">Mørk</option>
    </select>
</label>
