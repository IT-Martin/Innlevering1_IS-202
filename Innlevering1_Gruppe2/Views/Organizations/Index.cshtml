@model OrganizationAdminViewModel
@{
    ViewData["Title"] = Model.Platform ? "Tilgangsadministrasjon" : "Organisasjon og ansatte";
    var now = DateTime.UtcNow;
    var ownAccountId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}
<div class="management-page">
    <h1>@ViewData["Title"]</h1>
    <p>@(Model.Platform ? "Kontroller organisasjonen gjennom en uavhengig kanal før du godkjenner og inviterer første administrator." : "Inviter ansatte til egen organisasjon og gi bare tilgangen de trenger.")</p>
    @if (Model.Platform)
    {
        <p class="mb-4"><strong>@Model.Organizations.Count()</strong> virksomheter · <strong>@Model.Organizations.Count(org => org.approval_status == "Venter")</strong> søknader til behandling · <strong>@Model.Members.Count(member => member.Account.email_confirmed && !member.Account.access_revoked && member.PublicOrganization.approval_status == "Godkjent")</strong> aktive ansatte</p>
    }
    @foreach(var org in Model.Organizations){
        var hasAdministrator = Model.Members.Any(member => member.public_organization_id == org.public_organization_id
            && member.permission == "Organisasjonsadministrator" && !member.Account.access_revoked);
        var hasPendingAdministratorInvite = Model.Invitations.Any(invite => invite.public_organization_id == org.public_organization_id
            && invite.permission == "Organisasjonsadministrator" && !invite.revoked && !invite.used_at.HasValue && invite.expires_at > now);
    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h4">@org.organization_name</h2>
            <p>@org.organization_number · @org.organization_type · @org.approval_status</p>
            <p>Kontakt: @org.contact_name · @org.contact_email · @org.phone</p>
            <p>@org.verification</p>
            @if(Model.Platform){
            <p class="field-help">Gjeldende status: <strong>@org.approval_status</strong>. En ny vurdering erstatter den lagrede vurderingen.</p>
            <form asp-action="Review" method="post">
                <input name="id" type="hidden" value="@org.public_organization_id" />
                <div class="form-grid">
                    <label class="form-label">Status etter vurdering<select name="status" class="form-select" required>
                            @if (org.approval_status == "Venter")
                            {
                                <option value="" selected disabled>Velg en vurdering (venter på behandling)</option>
                            }
                            @foreach (var status in new[] { "Godkjent", "Sperret", "Avslått" })
                            {
                                <option value="@status" selected="@(status == org.approval_status)">@status</option>
                            }
                        </select>
                    </label>
                    <label class="form-label">Begrunnelse for denne vurderingen<textarea name="evidence" minlength="15" maxlength="1000" required class="form-control"></textarea>
                    </label>
                </div>
                <button class="btn btn-outline-primary">Lagre vurdering</button>
            </form>}
            @if (Model.Platform && org.approval_status == "Godkjent" && !hasAdministrator && !hasPendingAdministratorInvite)
            {
                <details class="mt-3" open>
                    <summary>Inviter første administrator</summary>
                    <p class="field-help">Velg jobbadressen til personen som skal administrere ansattilgangen.</p>
                    <form asp-action="Invite" method="post">
                        <input name="id" type="hidden" value="@org.public_organization_id" />
                        <input name="permission" type="hidden" value="Organisasjonsadministrator" />
                        <label class="form-label d-block">Jobb-e-post
                            <input name="email" type="email" value="@org.contact_email" required class="form-control" />
                        </label>
                        <button class="btn btn-primary">Inviter første administrator</button>
                    </form>
                </details>
            }
            else if (org.approval_status == "Godkjent") {
            <details class="mt-3">
                <summary>@(Model.Platform ? "Inviter organisasjonsadministrator eller ansatt" : "Inviter ansatt")</summary>
                <form asp-action="Invite" method="post">
                    <input name="id" type="hidden" value="@org.public_organization_id" />
                    <div class="form-grid">
                        <label class="form-label">Jobbadresse på @org.email_domain<input name="email" type="email" required class="form-control" />
                        </label>
                        <label class="form-label">Tilgang<select name="permission" class="form-select">
                                <option>Beredskapsansatt</option>
                                <option>Lesetilgang</option>
                                <option>Organisasjonsadministrator</option>
                            </select>
                        </label>
                    </div>
                    <p class="text-muted">Beredskapsansatt kan behandle behov og forespørsler. Lesetilgang gir ingen endringsrett. Organisasjonsadministrator kan i tillegg administrere ansatte.</p>
                    <button class="btn btn-primary">Send personlig invitasjon</button>
                </form>
            </details>}
        </div>
    </section>}
    <h2 class="h4">Ansatte</h2>
    @foreach(var member in Model.Members){
    <section class="card mb-3">
        <div class="card-body">
            <h3 class="h5">@member.Account.contact_name</h3>
            <p>@member.Account.email · @member.PublicOrganization.organization_name · @(member.Account.access_revoked ? "Sperret" : !member.Account.email_confirmed ? "E-postbekreftelse gjenstår" : "Aktiv")</p>
            @if (member.account_id.ToString() == ownAccountId)
            {
                <p>Din tilgang: <strong>@member.permission</strong></p>
                <p class="field-help">Dette er din egen konto. Du kan ikke endre egen rolle eller fjerne egen tilgang her. Kontakt systemansvarlig hvis tilgangen må endres.</p>
            }
            else
            {
            <form asp-action="Member" method="post">
                <input name="id" value="@member.account_id" type="hidden" />
                <label class="form-label">Tilgang<select name="permission" class="form-select">
                        @foreach(var permission in new[]{"Beredskapsansatt","Lesetilgang","Organisasjonsadministrator"}){
                        <option selected="@(permission == member.permission)">@permission</option>}
                    </select>
                </label>
                <label class="form-check-label mx-3">
                    <input name="revoked" type="checkbox" value="true" checked="@member.Account.access_revoked" /> Fjern tilgang</label>
                <button class="btn btn-outline-primary">Oppdater ansatt</button>
            </form>
            }
        </div>
    </section>}
    <h2 class="h4">Invitasjoner</h2>
    @foreach(var invite in Model.Invitations){
    <section class="card mb-2">
        <div class="card-body">
            <p>@invite.email · @invite.permission · @(invite.revoked ? "Sperret" : invite.used_at.HasValue ? "Brukt" : invite.expires_at < DateTime.UtcNow ? "Utløpt" : "Venter på aktivering")</p>
            @if(!invite.revoked && !invite.used_at.HasValue){
            <form asp-action="RevokeInvitation" method="post">
                <input name="id" value="@invite.invitation_id" type="hidden" />
                <button class="btn btn-outline-danger">Sperr invitasjon</button>
            </form>}
        </div>
    </section>}
    <details class="mt-4">
        <summary>Siste hendelser</summary>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Tid</th>
                        <th>Konto</th>
                        <th>Handling</th>
                        <th>Referanse</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var entry in Model.Audit){
                    <tr>
                        <td>@entry.occurred_at.ToLocalTime().ToString("dd.MM HH:mm")</td>
                        <td>@entry.account_id</td>
                        <td>@entry.action</td>
                        <td>@entry.target</td>
                    </tr>}
                </tbody>
            </table>
        </div>
    </details>
</div>
