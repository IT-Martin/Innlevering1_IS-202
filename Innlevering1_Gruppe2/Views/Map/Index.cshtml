@model List<MapItemViewModel>
@using System.Globalization
@{
    ViewData["Title"] = "Kart og ressurser";
    ViewData["FullMap"] = true;
    var supplier = User.IsInRole("Private");
    var canCreate = supplier || User.FindFirst("Permission")?.Value != "Lesetilgang";
    var legendIcons = Model.Select(item => new
    {
        Icon = item.TypeIcon,
        ColorClass = ResourceTypeIcon.CategoryClass(item.Category),
        Label = item.TypeIcon == "fa-solid fa-tractor" ? "Traktor"
            : item.TypeIcon == "fa-solid fa-helicopter" ? "Drone" : item.Category
    }).Distinct().OrderBy(item => item.Label).ToList();
}
<div class="map-page">
    <h1 class="visually-hidden">@(supplier ? "Mitt kart" : "Kart og ressurser")</h1>
    <section class="map-workspace" data-collection aria-label="Kart med søk og treff">
        @if (canCreate)
        {
            <a class="btn btn-primary map-mobile-action" href="@(supplier ? "/Resources/Register" : "/Needs/Create")"><i class="fa-solid fa-plus" aria-hidden="true"></i> @(supplier ? "Registrer ressurs" : "Meld behov")</a>
        }
        <details class="map-sidebar" open>
            <summary class="map-panel-toggle"><span><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Søk og treff</span><span data-count role="status"></span><i class="fa-solid fa-chevron-down panel-chevron" aria-hidden="true"></i></summary>
            <div class="map-panel-body">
    <div class="map-page-header">
        <div>
            <p class="eyebrow">RESSURSOVERSIKT</p>
            <h2>@(supplier ? "Mitt kart" : "Kart og ressurser")</h2>
            <p class="text-muted mb-0">@(supplier ? "Dine ressurser og åpne hjelpebehov, samlet på kartet." : "Finn ressursene som kan dekke behovene dine.")</p>
        </div>
        @if (supplier)
        {
            <a class="btn btn-primary map-panel-action" href="/Resources/Register"><i class="fa-solid fa-plus" aria-hidden="true"></i> Registrer ressurs</a>
        }
        else if (User.FindFirst("Permission")?.Value != "Lesetilgang")
        {
            <a class="btn btn-primary map-panel-action" href="/Needs/Create"><i class="fa-solid fa-plus" aria-hidden="true"></i> Meld behov</a>
        }
    </div>

            <div class="map-filters">
                <label class="form-label search-field">Søk
                    <input data-search type="search" class="form-control" placeholder="Navn, kategori eller sted" />
                </label>
                <div class="filter-pair">
                    <label class="form-label">Kategori
                        <select data-category class="form-select"><option value="">Alle kategorier</option></select>
                    </label>
                    <label class="form-label">Vis
                        <select data-kind class="form-select"><option value="">Alt</option><option>Ressurs</option><option>Behov</option></select>
                    </label>
                </div>
                <button type="button" data-reset hidden class="filter-reset">Nullstill filtre</button>
            </div>
            <div class="map-results-heading">
                <strong>Treff</strong>
                <label class="visually-hidden" for="map-sort">Sorter treff</label>
                <select id="map-sort" data-sort class="sort-select"><option value="name">Navn A–Å</option><option value="name-desc">Navn Å–A</option><option value="category">Kategori</option></select>
            </div>
            <p data-empty data-empty-initial="@(supplier ? "Du har ingen ressurser i kartet, og det finnes ingen åpne hjelpebehov ennå. Registrer en ressurs for å komme i gang." : canCreate ? "Ingen ressurser eller åpne hjelpebehov er registrert i kartet ennå. Du kan melde et behov fra denne siden." : "Ingen ressurser eller åpne hjelpebehov er registrert i kartet ennå.")" hidden class="map-no-results">Ingen treff med disse filtrene. Endre søket eller nullstill filtrene.</p>
            <ul id="resource-list" class="resource-list map-results" data-items>
                @foreach (var resource in Model)
                {
                    <li data-item data-name="@resource.Name" data-kind="@resource.Kind" data-category="@resource.Category" data-place="@resource.Place"
                        data-latitude="@resource.Latitude.ToString(CultureInfo.InvariantCulture)" data-longitude="@resource.Longitude.ToString(CultureInfo.InvariantCulture)"
                        data-status="@resource.Status" data-resource-name="@resource.Name" data-type-icon="@resource.TypeIcon" data-category-class="@ResourceTypeIcon.CategoryClass(resource.Category)">
                        <a href="@resource.Url" class="map-result-link">
                            <span class="category-icon @ResourceTypeIcon.CategoryClass(resource.Category)"><i class="@resource.TypeIcon" aria-hidden="true"></i></span>
                            <span class="map-result-copy"><small>@resource.Kind · @resource.Category</small><strong>@resource.Name</strong><span class="result-place">@resource.Place</span><span>
                                @if (resource.Kind == "Behov" && resource.Status == "Haster")
                                {
                                    <span class="urgent-badge" aria-hidden="true">!</span>
                                }
                                @resource.Status
                            </span></span>
                            <i class="fa-solid fa-chevron-right result-arrow" aria-hidden="true"></i>
                        </a>
                    </li>
                }
            </ul>
            @if (supplier)
            {
                <p class="privacy-note"><i class="fa-solid fa-lock" aria-hidden="true"></i> Andre leverandører ser ikke ressursene dine.</p>
            }
            </div>
        </details>
        <div class="map-canvas">
            <div id="map" role="region" aria-label="Kart over ressurser og behov"></div>
            <details class="map-legend @(canCreate ? "map-legend-with-action" : "")" open>
                <summary>Tegnforklaring</summary>
                <div class="map-legend-body">
                    <div class="map-legend-types">
                        <span><span class="legend-symbol" aria-hidden="true"><span class="resource-marker map-category-other legend-marker"></span></span> Ressurs</span>
                        <span><span class="legend-symbol" aria-hidden="true"><span class="resource-marker marker-need map-category-other legend-marker"></span></span> Hjelpebehov</span>
                    </div>
                    <p class="map-legend-help">Formen viser ressurs eller behov. Fyllfargen og ikonet viser kategori. Kanten på behov viser prioritet.</p>
                    <div class="map-legend-types mt-2">
                        <span><span class="urgent-badge" aria-hidden="true">!</span> <span class="need-priority-key need-urgent" aria-hidden="true"></span> Haster</span>
                        <span><span class="need-priority-key need-normal" aria-hidden="true"></span> Normal</span>
                        <span><span class="need-priority-key need-planned" aria-hidden="true"></span> Planlagt</span>
                    </div>
                    @if (legendIcons.Count > 0)
                    {
                        <p class="map-legend-label">Symboler i kartet</p>
                        <ul class="map-legend-icons">
                            @foreach (var item in legendIcons)
                            {
                                <li><span class="category-icon @item.ColorClass"><i class="@item.Icon" aria-hidden="true"></i></span><span>@item.Label</span></li>
                            }
                        </ul>
                    }
                </div>
            </details>
        </div>
    </section>
</div>
@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>

    <script>
        if (!window.L) {
            document.getElementById('map').textContent = 'Kartet kunne ikke lastes. Prøv å laste siden på nytt. Du kan fortsatt bruke trefflisten.';
            document.querySelector('.map-sidebar').open = true;
        } else {
        const worldBounds = L.latLngBounds([-85.05112878, -180], [85.05112878, 180]);
        const map = L.map("map", {
            zoomControl: false,
            maxBounds: worldBounds,
            maxBoundsViscosity: 1
        }).setView([58.1467, 7.9956], 13);

        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                maxZoom: 19,
                noWrap: true,
                attribution: "&copy; OpenStreetMap-bidragsytere"
            }
        ).addTo(map);

        map.createPane("urgentMarkers").style.zIndex = "610";
        L.control.zoom({ position: "topright" }).addTo(map);
        const panel = document.querySelector('.map-sidebar');
        if (window.matchMedia('(max-width:700px)').matches) {
            panel.open = false;
            document.querySelector('.map-legend').open = false;
        }
        const needPriorityClasses = new Map([
            ["Haster", "need-urgent"],
            ["Normal", "need-normal"],
            ["Planlagt", "need-planned"]
        ]);
        const markerEntries = [];

        document.querySelectorAll("#resource-list [data-latitude]")
            .forEach(element => {
                const latitude = Number.parseFloat(
                    element.dataset.latitude
                );

                const longitude = Number.parseFloat(
                    element.dataset.longitude
                );

                if (!Number.isFinite(latitude)
                    || !Number.isFinite(longitude)) {
                    return;
                }

                const position = [latitude, longitude];

                //Bruker tekstContent slik at ressursdata behandles som tekst og ikke som HTML
                const popup = document.createElement("div");

                const resourceName = document.createElement("strong");
                resourceName.textContent = element.dataset.resourceName;

                const coordinates = document.createElement("div");
                coordinates.textContent =
                    `${element.dataset.kind} · ${element.dataset.category} · ${element.dataset.place}`;

                popup.append(resourceName, coordinates);

                const markerContent = document.createElement("div");
                const isNeed = element.dataset.kind === "Behov";
                markerContent.className = isNeed ? "resource-marker marker-need" : "resource-marker";
                markerContent.classList.add(element.dataset.categoryClass || "map-category-other");

                if (isNeed) {
                    const priority = element.dataset.status;
                    const priorityClass = needPriorityClasses.get(priority);
                    if (priorityClass) markerContent.classList.add(priorityClass);

                    if (priority === "Haster") {
                        const badge = document.createElement("span");
                        badge.className = "urgent-badge";
                        badge.textContent = "!";
                        badge.setAttribute("aria-hidden", "true");
                        markerContent.append(badge);
                    }

                    const priorityText = document.createElement("div");
                    priorityText.textContent = `Prioritet: ${priority}`;
                    popup.append(priorityText);
                }

                const markerGlyph = document.createElement("i");
                markerGlyph.className = "resource-marker-glyph";
                markerGlyph.setAttribute("aria-hidden", "true");
                markerContent.append(markerGlyph);

                const markerIconClass = element.dataset.typeIcon || "fa-solid fa-location-dot";
                markerGlyph.className = `${markerIconClass} resource-marker-glyph`;

                const markerIcon = L.divIcon({
                    className: "resource-marker-container",
                    html: markerContent.outerHTML,
                    iconSize: [46, 50],
                    iconAnchor: isNeed ? [23, 41] : [23, 47],
                    popupAnchor: [0, -42]
                });

                const link = document.createElement("a");
                link.href = element.querySelector("a").href;
                link.textContent = "Se detaljer";
                popup.append(link);
                const markerLabel = `${element.dataset.kind}: ${element.dataset.resourceName} (${element.dataset.category})` + (isNeed ? ` · ${element.dataset.status}` : "");
                // Hastebehov plasseres i et eget kartlag foran vanlige markører.
                const isUrgent = isNeed && element.dataset.status === "Haster";
                const marker = L.marker(position, {
                    icon: markerIcon,
                    title: markerLabel,
                    alt: markerLabel,
                    pane: isUrgent ? "urgentMarkers" : "markerPane"
                }).addTo(map).bindPopup(popup);
                markerEntries.push({ element, marker });
            });
        function fitVisibleMarkers() {
            const visible = markerEntries.filter(entry => !entry.element.hidden).map(entry => entry.marker.getLatLng());
            if (visible.length === 0) return;
            const mobile = window.matchMedia('(max-width:700px)').matches;
            const options = { maxZoom: 15, paddingTopLeft: [28, 64], paddingBottomRight: [64, 28] };
            if (panel.open && mobile) options.paddingBottomRight = [64, Math.min(panel.offsetHeight + 24, map.getSize().y - 150)];
            else if (panel.open) options.paddingTopLeft = [panel.offsetWidth + 40, 64];
            map.fitBounds(visible, options);
        }
        document.querySelector("[data-collection]").addEventListener("collectionchange", () => {
            for (const entry of markerEntries) {
                if (entry.element.hidden) map.removeLayer(entry.marker);
                else entry.marker.addTo(map);
            }
            fitVisibleMarkers();
        });
        panel.addEventListener('toggle', () => requestAnimationFrame(fitVisibleMarkers));
        map.on('resize', fitVisibleMarkers);
        fitVisibleMarkers();
        }
    </script>
}
