@{ var fullMap = ViewData["FullMap"] is true; }
<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Beredskapssentralen</title>
    <script type="importmap"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
</head>
<body>
    <a class="skip-link" href="#main-content">Hopp til innhold</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container app-container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">
                        <i class="fa-solid fa-people-group"></i>
                    </span>
                    <span>Beredskapssentralen<span class="brand-caption">RESSURSER · BEREDSKAP</span></span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Åpne navigasjon">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav main-nav me-auto">
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li class="nav-item"><a class="nav-link" href="/">Hjem</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organizations" asp-action="Apply">Søk om offentlig tilgang</a></li>
                        }
                        else if (User.IsInRole("Platform"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/Organizations">Tilgangsadministrasjon</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Map" asp-action="Index">Kartoversikt</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="/Map">@(User.IsInRole("Private") ? "Mitt kart" : "Kart og ressurser")</a></li>
                            <li class="nav-item"><a class="nav-link" href="@(User.IsInRole("Private") ? "/Resources/MyContributions" : "/Needs")">@(User.IsInRole("Private") ? "Mine bidrag" : "Mine behov")</a></li>
                            @if (User.IsInRole("Private"))
                            {
                                <li class="nav-item"><a class="nav-link" href="/Needs">Åpne hjelpebehov</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" href="/Requests">Forespørsler</a></li>
                            @if (!User.IsInRole("Private"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Frivillighet</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="/Volunteers">Frivillige</a></li>
                                        <li><a class="dropdown-item" href="/Interests">Frivilligpåmeldinger</a></li>
                                    </ul>
                                </li>
                            }
                            @if (User.IsInRole("Private") || User.FindFirst("Permission")?.Value != "Lesetilgang")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Mer</a>
                                    <ul class="dropdown-menu">
                                        @if (User.IsInRole("Private"))
                                        {
                                            <li><a class="dropdown-item" href="/Volunteers/Edit">Min frivilligprofil</a></li>
                                            <li><a class="dropdown-item" href="/Interests">Mine påmeldinger</a></li>
                                        }
                                        else
                                        {
                                            @if (User.FindFirst("Permission")?.Value == "Organisasjonsadministrator")
                                            { <li><a class="dropdown-item" href="/Organizations">Organisasjon og ansatte</a></li> }
                                            @if (User.FindFirst("Permission")?.Value != "Lesetilgang")
                                            { <li><a class="dropdown-item" href="/Exports">Last ned ressursliste (CSV)</a></li> }
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <div class="account-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="account-email" title="@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value">
                                <i class="fa-regular fa-user" aria-hidden="true"></i>
                                @(User.IsInRole("Platform") ? "Systemansvarlig" : User.IsInRole("Private") ? "Leverandør" : "Offentlig aktør")
                            </span>
                            <a class="nav-link" asp-controller="Account" asp-action="Profile">Min konto</a>
                            <form asp-controller="Login" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link logout-button">Logg ut</button>
                            </form>
                        }
                        else if (ViewData["LandingPage"] is true)
                        {
                            <partial name="_ThemePicker" />
                            <a class="account-action" asp-controller="Home" asp-action="About">Om Beredskapssentralen</a>
                        }
                        else
                        {
                            <a class="account-action account-login" asp-controller="Login" asp-action="Index">
                                <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
                                Logg inn
                            </a>
                            <a class="account-action account-register" asp-controller="Login" asp-action="Register">
                                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                                Opprett bruker
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container app-container @(fullMap ? "full-map-container" : "")">
        <main id="main-content" role="main">
            @if (ViewData["IsHttpError"] is not true && TempData["Message"] is string message)
            { <div class="alert alert-info mt-3" role="status">@message</div> }
            @if (ViewData["IsHttpError"] is not true && TempData["LocalLink"] is string localLink)
            { <div class="alert alert-warning mt-3"><strong>Lokal forhåndsvisning – ingen e-post er sendt.</strong> <a id="local-link" href="@localLink">Åpne personlig testlenke</a></div> }
            @RenderBody()
        </main>
    </div>

    @if (!fullMap)
    {
    <footer class="site-footer">
        <div class="container app-container">
            <span>&copy; 2026 Beredskapssentralen</span>
            <span>Enklere deling av viktige ressurser</span>
        </div>
    </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
