@model IReadOnlyList<VolunteerDirectoryEntryViewModel>
    @{ ViewData["Title"] = "Frivillige"; }
    <div class="management-page">
        <h1>Frivillige</h1>
        <p>Aktive frivilligprofiler. Kontaktpersonen vurderer selv hvem som passer behovet.</p>
        <section data-collection>
            @if (Model.Count == 0)
            {
                <div class="empty-state card"><div class="card-body">
                    <h2 class="h4">Ingen aktive frivilligprofiler ennå</h2>
                    <p class="mb-0">Frivillige vises her når leverandører har opprettet og aktivert en frivilligprofil. @if (User.FindFirst("Permission")?.Value != "Lesetilgang") { <span>Du kan melde et behov for frivillig hjelp under <a href="/Needs">Mine behov</a>.</span> }</p>
                </div></div>
            }
            else
            {
                <partial name="_ListTools" />
            }
                <div class="resource-grid" data-items>
                    @foreach(var entry in Model){
                    var profile = entry.Profile;
                    <article class="card" data-item data-name="@profile.volunteer_role @profile.ProviderAccount.Account.contact_name @string.Join(", ", profile.VolunteerProfileSkills.Select(skill => skill.Skill.name))" data-category="Frivillig" data-place="@profile.service_area">
                        <div class="card-body">
                            <h2 class="h5">@profile.volunteer_role</h2>
                            <p>@profile.service_area</p>
                            <p>@string.Join(", ", profile.VolunteerProfileSkills.Select(skill => skill.Skill.name))</p>
                            <p>@profile.additional_information</p>
                            <details>
                                <summary>Tilgjengelige perioder</summary>
                                @foreach (var period in entry.Periods)
                                {
                                    <p>@period.available_from.ToString("dd.MM.yyyy HH:mm") – @period.available_to.ToString("dd.MM.yyyy HH:mm")</p>
                                }
                                @if (entry.Periods.Count == 0)
                                {
                                    <p>Ingen perioder oppgitt. Avtal tidspunkt direkte med den frivillige.</p>
                                }
                            </details>
                            <p>@profile.ProviderAccount.Account.contact_name · @profile.ProviderAccount.Account.email · @profile.ProviderAccount.Account.phone</p>
                        </div>
                    </article>}
                </div>
            </section>
        </div>
