@model AvailabilityViewModel
@{ ViewData["Title"] = "Tilgjengelighet"; }
<div class="management-page">
    <h1>Tilgjengelighet</h1>
    <h2 class="h4">@Model.Name</h2>
    <p>@(Model.Volunteer ? "Oppgi når du kan bidra. Tidspunkt og oppgaver avtales med kontaktpersonen for behovet." : "Du kan legge til flere tilgjengelige perioder. Overlapp og aktive reservasjoner kontrolleres ved lagring.")</p>
    @if (Model.Archived)
    {
        <p class="alert alert-info">Bidraget er arkivert. Gjenopprett det før du legger til nye perioder.</p>
    }
    @foreach(var period in Model.Periods){
    <article class="card mb-2">
        <div class="card-body d-flex justify-content-between flex-wrap gap-3">
            <span>@period.available_from.ToString("dd.MM.yyyy HH:mm") – @period.available_to.ToString("dd.MM.yyyy HH:mm")</span>
            <form asp-action="Remove" method="post">
                <input name="id" value="@period.availability_id" type="hidden" />
                <input name="ownerId" value="@Model.Id" type="hidden" />
                <input name="volunteer" value="@Model.Volunteer.ToString().ToLowerInvariant()" type="hidden" />
                <button class="btn btn-outline-danger">Fjern periode</button>
            </form>
        </div>
    </article>}
    @if (!Model.Archived)
    {
    <section class="card mt-4">
        <div class="card-body">
            <h2 class="h4">Legg til periode</h2>
            <form asp-action="Add" method="post">
                <input name="id" value="@Model.Id" type="hidden" />
                <input name="volunteer" value="@Model.Volunteer.ToString().ToLowerInvariant()" type="hidden" />
                <div class="form-grid">
                    <label class="form-label">Fra<input name="start" type="datetime-local" class="form-control" required />
                    </label>
                    <label class="form-label">Til<input name="end" type="datetime-local" class="form-control" required />
                    </label>
                </div>
                <button class="btn btn-primary">Legg til periode</button>
            </form>
        </div>
    </section>
    }
    <a class="d-block mt-3" href="@(Model.Volunteer ? "/Volunteers/Edit" : "/Resources/MyContributions")">Tilbake til bidraget</a>
</div>
