@model Reachout.Models.AccountRegistrationViewModel

@{
    ViewData["Title"] = "Opprett konto";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1>@(string.IsNullOrEmpty(Model.Invitation) ? "Opprett leverandørkonto" : "Aktiver invitert offentlig konto")</h1>
        <p>@(string.IsNullOrEmpty(Model.Invitation) ? "For privatpersoner, bedrifter og organisasjoner som vil bidra." : "Du får tilgangen organisasjonens administrator har invitert deg til. Jobbadressen må bekreftes.")</p>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Invitation" type="hidden" />
            @if (string.IsNullOrEmpty(Model.Invitation))
            {
                <div class="row g-3 align-items-end mb-3">
                    <div class="col-auto">
                        <label asp-for="ProviderType" class="form-label">Leverandørtype</label>
                        <select asp-for="ProviderType" class="form-select" style="width: 150px;">
                            <option>Privatperson</option>
                            <option>Bedrift</option>
                            <option>Organisasjon</option>
                        </select>
                        <span asp-validation-for="ProviderType" class="text-danger"></span>
                    </div>
                    <div class="col-auto">
                        <label asp-for="Organization" class="form-label">Navn på bedrift eller organisasjon (valgfritt)</label>
                        <input asp-for="Organization" class="form-control" style="width: 260px;" maxlength="260" />
                    </div>
                </div>
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ContactName" class="form-label">Navn</label>
                <input asp-for="ContactName" class="form-control" autocomplete="name" />
                <span asp-validation-for="ContactName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">Telefonnummer</label>
                <input asp-for="Phone" class="form-control" autocomplete="tel" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-post</label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Passord</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Bekreft passord</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Opprett konto</button>
            <a asp-action="Index" class="btn btn-link">Jeg har allerede konto</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
