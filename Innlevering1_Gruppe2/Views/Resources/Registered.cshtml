@model ResourceRegistrationResultViewModel

@{
    ViewData["Title"] = "Ressursen er registrert";
}

<div class="result-page registration-result">
    <section class="result-card card text-center" aria-labelledby="registration-title">
        <div class="card-body p-4 p-md-5">
            <div class="success-icon" aria-hidden="true">
                <i class="fa-solid fa-check"></i>
            </div>

            <h1 id="registration-title">Ressursen er registrert</h1>
            <p class="text-muted">
                <strong>@Model.Name</strong> er lagret i Mine bidrag.
            </p>
            <p class="text-muted mb-0">Du kan se detaljene eller registrere en ny ressurs.</p>

            <div class="result-actions">
                <a class="btn btn-primary"
                   asp-controller="Resources"
                   asp-action="Details"
                   asp-route-id="@Model.Id">Se ressursen</a>
                <a class="btn btn-outline-secondary"
                   asp-controller="Resources"
                   asp-action="MyContributions">Mine bidrag</a>
                <a class="btn btn-outline-secondary"
                   asp-controller="Resources"
                   asp-action="Register">Registrer en ny ressurs</a>
            </div>
        </div>
    </section>
</div>
