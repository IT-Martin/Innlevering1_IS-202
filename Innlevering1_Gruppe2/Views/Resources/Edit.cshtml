@model Reachout.Models.ResourceEditViewModel

@{
    ViewData["Title"] = "Endre ressurs";
    var resourceTypes = ViewBag.ResourceTypes as IEnumerable<Reachout.Models.Entities.ResourceType>
        ?? Enumerable.Empty<Reachout.Models.Entities.ResourceType>();
}

<div class="form-page">
    <div class="form-page-header">
        <div><p class="eyebrow">MINE BIDRAG</p><h1>Endre ressurs</h1><p class="text-muted mb-0">Oppdater informasjonen eller velg en ny plassering på kartet.</p></div>
    </div>

    <form asp-action="Edit" method="post" class="resource-form card" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="card-body">
            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Navn på ressurs</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Beskrivelse</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ResourceTypeId" class="form-label">Type</label>
                <select asp-for="ResourceTypeId" class="form-select">
                    <option value="">Velg type</option>
                    @foreach (var type in resourceTypes)
                    {
                        <option value="@type.resource_type_id">@type.category_name</option>
                    }
                </select>
                <span asp-validation-for="ResourceTypeId" class="text-danger"></span>
            </div>

            <div class="location-picker-header">
                <div>
                    <h2 class="h5 mb-1">Posisjon</h2>
                    <p class="small text-muted mb-0">Klikk på kartet for å flytte markøren.</p>
                </div>
            </div>

            <div id="edit-map" data-picker-map class="map-picker" aria-label="Kart for redigering av ressursposisjon"></div>
            <input asp-for="Latitude" id="latitudeInput" type="hidden" data-latitude />
            <input asp-for="Longitude" id="longitudeInput" type="hidden" data-longitude />
            <span asp-validation-for="Latitude" class="text-danger"></span>
            <span asp-validation-for="Longitude" class="text-danger"></span>

            <p data-picker-status class="field-help" role="status">Plasseringen er valgt.</p>
            <details class="coordinate-details"><summary>Vis koordinater</summary>
                <div class="coordinate-readout" aria-live="polite">
                    <span id="latitudeDisplay">@Model.Latitude?.ToString("F6")</span>,
                    <span id="longitudeDisplay">@Model.Longitude?.ToString("F6")</span>
                </div>
            </details>
            <div class="form-grid mt-3"><label class="form-label">Adresse eller område<input asp-for="Address" class="form-control" /></label><label class="form-label">Tilgjengelighet<select asp-for="AvailabilityStatus" class="form-select"><option>Tilgjengelig nå</option><option>Etter avtale</option><option>Ikke tilgjengelig</option></select></label></div>
            <p><a href="/Availability/Index/@Model.Id">Endre tilgjengelige perioder</a></p>
            @if(Model.HasPhoto){<img class="resource-photo small-photo" src="/Resources/Photo/@Model.Id" alt="Nåværende ressursbilde" />}
            <label class="form-label d-block">Velg eller erstatt bilde<input asp-for="Photo" type="file" accept="image/png,image/jpeg" class="form-control" /></label>
            <label class="form-check-label"><input asp-for="RemovePhoto" /> Fjern eksisterende bilde ved lagring</label>
            <div class="form-actions mt-4">
                <button type="submit" class="btn btn-primary">Lagre endringer</button>
                <a class="btn btn-light" asp-action="MyContributions">Avbryt</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="/js/location-map.js" asp-append-version="true"></script>
}
