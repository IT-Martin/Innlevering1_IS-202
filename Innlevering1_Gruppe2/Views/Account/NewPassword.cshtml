@{ ViewData["Title"] = "Velg nytt passord"; }
<div class="management-page">
    <h1>Velg nytt passord</h1>
    <div class="auth-card mx-auto">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger">
            </div>
            <input name="token" value="@ViewBag.Token" type="hidden" />
            <label class="form-label">Nytt passord<input name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" class="form-control" required />
            </label>
            <label class="form-label">Gjenta passord<input name="confirm" type="password" autocomplete="new-password" class="form-control" required />
            </label>
            <button class="btn btn-primary">Lagre nytt passord</button>
        </form>
    </div>
</div>
