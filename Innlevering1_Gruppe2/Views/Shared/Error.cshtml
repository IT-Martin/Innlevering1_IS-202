@model ErrorViewModel
@{ ViewData["Title"] = "Noe gikk galt"; }
<div class="management-page">
    <h1>Noe gikk galt</h1>
    <p>Vi kunne ikke fullføre forespørselen. Prøv igjen om litt.</p>
    @if (Model.ShowRequestId)
    {
        <p>Referanse ved feilsøking: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Tilbake til startsiden</a>
</div>
