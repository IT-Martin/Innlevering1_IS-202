<div class="collection-tools form-grid mb-3">
    <label class="form-label">Søk<input data-search type="search" class="form-control" placeholder="Navn, sted eller kategori" />
    </label>
    <label class="form-label">Kategori<select data-category class="form-select">
            <option value="">Alle kategorier</option>
        </select>
    </label>
    <label class="form-label">Sorter<select data-sort class="form-select">
            <option value="name">Navn A–Å</option>
            <option value="name-desc">Navn Å–A</option>
            <option value="category">Kategori</option>
        </select>
    </label>
</div>
<p data-count class="text-muted" role="status">
</p>
<button type="button" data-reset hidden class="filter-reset mb-3">Nullstill filtre</button>
<p data-empty hidden>Ingen treff. Prøv et annet søk eller velg Alle kategorier.</p>
