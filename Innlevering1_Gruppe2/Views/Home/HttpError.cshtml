@model HttpErrorViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="management-page">
    <section class="card">
        <div class="card-body">
            <h1>@Model.Title</h1>
            <p>@Model.Message</p>
            <div class="resource-actions">
                <a class="btn btn-primary" asp-controller="Login" asp-action="Index">Åpne innloggingen på nytt</a>
                <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Til startsiden</a>
            </div>
            <p class="text-muted mt-3">Feilkode: @Model.StatusCode</p>
        </div>
    </section>
</div>
