@model ResourceEditViewModel
@{
    ViewData["Title"] = "Registrer ressurs";
    var resourceTypes = ViewBag.ResourceTypes as IEnumerable<Reachout.Models.Entities.ResourceType>
        ?? Enumerable.Empty<Reachout.Models.Entities.ResourceType>();
}

<div class="register-page">
    <div class="mb-4">
        <h1 class="display-6">Registrer ressurs</h1>

        <p class="text-muted">
            Skriv inn ressursen og velg plasseringen på kartet.
        </p>
        <p>Vil du bidra som frivillig? <a asp-controller="Volunteers" asp-action="Edit">Opprett eller oppdater frivilligprofilen din</a>.</p>
    </div>

    @* Lagrer ressursen med valgt kategori, plassering og tilgjengelighet. *@
    <form asp-controller="Resources"
          asp-action="Register"
          method="post" enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div class="card register-card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Ressursinformasjon</h2>


                @* Viser valideringsfeil fra lagringen. *@
                @if (ViewData["ErrorMessage"] is string errorMessage)
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="resource-input mb-3">
                    <label for="Name" class="form-label">
                        Navn på ressurs
                    </label>

                    <input asp-for="Name"
                           type="text"
                           class="form-control"
                           placeholder="For eksempel traktor"
                           required />
                </div>

                <div class="resource-input mb-3">
                    <label for="Description" class="form-label">
                        Beskrivelse
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Skriv en beskrivelse av ressursen"></textarea>
                </div>

                

                <div class="resource-input mb-3">
                    <label for="ResourceTypeId" class="form-label">
                        Kategori
                    </label>

                    <select asp-for="ResourceTypeId"
                            class="form-select"
                            required>
                        <option value="">Velg kategori</option>
                        @foreach (var type in resourceTypes)
                        {
                            <option value="@type.resource_type_id">
                                @type.category_name
                            </option>
                        }
                    </select>
                </div>

                <h2 class="h5 mb-3">Velg posisjon</h2>

                <div id="map" data-picker-map
                     aria-label="Kart for valg av posisjon">
                </div>
                @* JavaScript fyller disse feltene med valgt kartposisjon *@
                <input type="hidden"
                       id="latitudeInput"
                       asp-for="Latitude" data-latitude />

                <input type="hidden"
                       id="longitudeInput"
                       asp-for="Longitude" data-longitude />

                <details class="coordinate-details"><summary>Vis koordinater</summary>
                <div class="coordinates-card mt-3">
                    <div>
                        <span class="coordinate-label">Breddegrad</span>
                        <strong id="latitude">-</strong>
                    </div>

                    <div>
                        <span class="coordinate-label">Lengdegrad</span>
                        <strong id="longitude">-</strong>
                    </div>
                </div>

                </details>

                <div id="map-message"
                     class="alert alert-info mt-3 mb-0" role="status">
                    Klikk på kartet for å velge en posisjon.
                </div>

                <label class="form-label d-block mt-3">Adresse eller område<input asp-for="Address" class="form-control" /></label>
                <h2 class="form-section-title">Tilgjengelighet</h2>
                <label class="form-label d-block">Når kan ressursen brukes?<select asp-for="AvailabilityStatus" class="form-select"><option>Tilgjengelig nå</option><option>Etter avtale</option><option>Ikke tilgjengelig</option></select></label>
                <p class="field-help">Perioden angir når ressursen kan forespørres. Ved «Etter avtale» avklares bruken med deg.</p>
                <div class="form-grid period-fields">
                    <label class="form-label">Fra (norsk tid)<input asp-for="Start" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" required /></label>
                    <label class="form-label">Til<input asp-for="End" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" required /></label>
                </div>
                <label class="form-label d-block mt-3">Bilde (valgfritt, PNG/JPEG, maks 2 MB)<input asp-for="Photo" type="file" accept="image/png,image/jpeg" class="form-control" /></label>
                <button id="confirm-position"
                        type="submit"
                        class="btn btn-primary mt-3"
                        disabled>
                    Registrer ressurs
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>

    <script src="/js/location-map.js" asp-append-version="true"></script>
}
