@model ProfileViewModel
@{ ViewData["Title"] = "Min konto"; }
<div class="management-page">
    <h1>Min konto</h1>
    <div class="mb-3"><partial name="_ThemePicker" /></div>
    <section class="card">
        <div class="card-body">
            <p>E-post: @Model.Email</p>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger">
                </div>
                <div class="form-grid">
                    <label class="form-label">Navn<input asp-for="Name" class="form-control" />
                    </label>
                    <label class="form-label">Telefon<input asp-for="Phone" class="form-control" />
                    </label>
                    @if (User.IsInRole("Private")) {
                    <label class="form-label">Leverandørtype<select asp-for="ProviderType" class="form-select">
                            <option>Privatperson</option>
                            <option>Bedrift</option>
                            <option>Organisasjon</option>
                        </select>
                    </label>
                    <label class="form-label">Adresse<input asp-for="Address" class="form-control" />
                    </label>
                    <label class="form-label">Bedrift eller organisasjon<input asp-for="Organization" class="form-control" />
                    </label>
                    <label class="form-label">Organisasjonsnummer<input asp-for="OrganizationNumber" class="form-control" />
                    </label>}
                </div>
                <button class="btn btn-primary">Lagre profil</button>
            </form>
        </div>
    </section>
    <section class="card mt-4">
        <div class="card-body">
            <h2 class="h4">Endre passord</h2>
            <form asp-action="Password" method="post">
                <div class="form-grid">
                    <label class="form-label">Gjeldende passord<input name="current" type="password" autocomplete="current-password" required class="form-control" />
                    </label>
                    <label class="form-label">Nytt passord<input name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required class="form-control" />
                    </label>
                    <label class="form-label">Gjenta nytt passord<input name="confirm" type="password" autocomplete="new-password" required class="form-control" />
                    </label>
                </div>
                <button class="btn btn-primary">Endre passord og logg ut</button>
            </form>
        </div>
    </section>
</div>
