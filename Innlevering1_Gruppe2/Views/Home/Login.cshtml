
@{
    ViewData["Title"] = "Logg inn";

    var role = ViewData["Role"]?.ToString();

    var roleTitle = role switch
    {
        "provider" => "Ressursleverandør",
        "public" => "Offentlig beredskapsaktør",
        _ => "Velkommen tilbake"
    };

    var roleDescription = role switch
    {
        "provider" => "Logg inn for å administrere dine ressurser.",
        "public" => "Logg inn for å få tilgang til beredskapsressursene.",
        _ => "Logg inn for å fortsette til Beredskap."
    };

    var roleLabel = role switch
    {
        "provider" => "RESSURSLEVERANDØR",
        "public" => "OFFENTLIG BEREDSKAPSAKTØR",
        _ => "VELKOMMEN TILBAKE"
    };
}

<div class="login-page">
    <div class="login-container">

        <!-- Venstre introduksjonspanel -->
        <section class="login-intro">

            <div class="login-brand">
                <img src="~/images/beredskap-logo-png.png"
                     alt="Beredskap logo"
                     class="login-logo" />

                <h1>Beredskap</h1>
                <p>Krisehåndtering når det gjelder.</p>
            </div>

            <div class="login-message">
                @* Viser hvilken brukergruppe som har valgt å logge inn. *@
                <span>@roleLabel</span>
                <h2>Sammen står vi sterkere.</h2>
            </div>

        </section>

        <!-- Høyre innloggingspanel -->
        <section class="login-content">

            <div class="login-card">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="login-back">
                    ← Tilbake
                </a>

                <hr />

                @* Viser innloggingstekst tilpasset valgt brukerrolle. *@
                <h2>@roleTitle</h2>
                <p class="login-description">
                    @roleDescription
                </p>

                @if (ViewData["ErrorMessage"] is string errorMessage)
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                <form method="post" asp-action="Login">

                    <div class="login-field">
                        <label for="email">E-postadresse</label>
                        <input id="email"
                               name="email"
                               type="email"
                               class="form-control"
                               placeholder="navn@eksempel.no"
                               required />
                    </div>

                    <div class="login-field">
                        <label for="password">Passord</label>
                        <input id="password"
                               name="password"
                               type="password"
                               class="form-control"
                               placeholder="Skriv inn passord"
                               required />
                    </div>

                    <div class="forgot-password">
                        <a href="#">Glemt passord?</a>
                    </div>

                    <button type="submit" class="login-submit">
                        Logg inn
                    </button>

                </form>

                @* Sender brukeren videre til opprettelse av brukerkonto. *@
<p class="login-register">
    Har du ikke konto?
    <a asp-controller="Home"
       asp-action="Register">
        Opprett konto
    </a>
</p>

            </div>

        </section>
    </div>
</div>
