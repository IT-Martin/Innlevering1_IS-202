@model Reachout.Models.LoginViewModel

@{
    ViewData["Title"] = "Logg inn";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card-heading">
            <span class="auth-icon" aria-hidden="true">
                <i class="fa-solid fa-right-to-bracket"></i>
            </span>
            <h1>Logg inn</h1>
        </div>

        <form asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label">Brukerinngang</label>
                <select asp-for="Role" class="form-select"><option value="Private">Ressursleverandør</option><option value="Public">Offentlig aktør</option><option value="Platform">Systemansvarlig</option></select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-post</label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Passord</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="auth-actions">
                <button type="submit" class="btn btn-primary">Logg inn</button>
                <a asp-action="Register" class="btn btn-link">Opprett leverandørkonto</a>
            </div>
        </form>
        <p class="field-help mt-3">Offentlige brukere opprettes via en personlig invitasjon fra organisasjonens administrator. Registrering som leverandør gir ikke offentlig tilgang.</p>
        <p class="mt-3"><a href="/Account/Forgot">Glemt passord?</a> · <a href="/Organizations/Apply">Søk om organisasjonstilgang</a></p>
        <details><summary>Send bekreftelse på nytt</summary><form asp-action="ResendConfirmation" method="post"><label class="form-label">Jobbadresse<input name="email" type="email" class="form-control" required /></label><button class="btn btn-outline-primary">Send bekreftelseslenke</button></form></details>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
