@model IReadOnlyList<VolunteerInterest>
    @{ ViewData["Title"] = User.IsInRole("Private") ? "Mine påmeldinger" : "Frivilligpåmeldinger"; ViewData["VolunteerFlow"] = true; }
    <div class="management-page">
        <h1>@ViewData["Title"]</h1>
        <p>Her følger du påmeldinger til konkrete hjelpebehov. «Ønsker kontakt» betyr at kontaktpersonen vil avtale bidraget nærmere.
        <a class="d-block mt-2" href="/Needs">Se hjelpebehov</a></p>
        <partial name="_StatusTabs" />
            @foreach(var interest in Model){
            <partial name="_InterestCard" model="interest" />}@if(Model.Count == 0){
                <p>Ingen påmeldinger med valgt status.</p>}
            </div>
