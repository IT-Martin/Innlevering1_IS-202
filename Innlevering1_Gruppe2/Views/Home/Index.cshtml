@{
    ViewData["Title"] = "Hjem";
    ViewData["LandingPage"] = true;
}

<section class="hero-section">
    <div class="hero-content">
        <p class="eyebrow">BEREDSKAPSSENTRALEN</p>
        <h1>Finn og del ressurser når det gjelder.</h1>
        <p class="hero-lead">
            Registrer tilgjengelige ressurser, se dem på kartet og gjør informasjonen
            tilgjengelig for offentlige beredskapsaktører. Andre leverandører ser bare sine egne ressurser.
        </p>

        <div class="hero-actions" aria-label="Hovedhandlinger">
            <a asp-controller="Login" asp-action="Index"
               class="btn btn-primary btn-lg hero-action-primary">
                Logg inn <span aria-hidden="true">→</span>
            </a>
            <a asp-controller="Login" asp-action="Register"
               class="btn btn-light btn-lg hero-action-secondary">
                Opprett konto
            </a>
        </div>

        <p class="hero-note">
            Offentlig bruker? Velg «Offentlig aktør» ved innlogging. Nye offentlige brukere trenger en invitasjon fra organisasjonen.
        </p>
    </div>

    <div class="hero-visual" aria-hidden="true">
        <div class="hero-map-preview">
            <span class="map-grid-line map-grid-line-one"></span>
            <span class="map-grid-line map-grid-line-two"></span>
            <span class="map-pin map-pin-one"><i class="fa-solid fa-tractor"></i></span>
            <span class="map-pin map-pin-two"><i class="fa-solid fa-droplet"></i></span>
            <span class="map-pin map-pin-three"><i class="fa-solid fa-bolt"></i></span>
            <div class="map-preview-label">
                <span class="map-preview-dot"></span>
                Ressurser og beredskap
            </div>
        </div>
    </div>
</section>

<section class="how-it-works" aria-labelledby="how-it-works-title">
    <div class="section-heading">
        <p class="eyebrow">SLIK FUNGERER DET</p>
        <h2 id="how-it-works-title">Tre enkle steg</h2>
    </div>

    <div class="step-grid">
        <article class="step-card">
            <span class="step-number">01</span>
            <h3>Registrer</h3>
            <p>Legg inn ressursen og velg nøyaktig plassering på kartet.</p>
        </article>
        <article class="step-card">
            <span class="step-number">02</span>
            <h3>Finn på kartet</h3>
            <p>Se egne bidrag eller finn ressurser som offentlig aktør.</p>
        </article>
        <article class="step-card">
            <span class="step-number">03</span>
            <h3>Hold oppdatert</h3>
            <p>Endre eller fjern dine egne ressurser når informasjonen endrer seg.</p>
        </article>
    </div>
</section>

<section class="how-it-works" aria-labelledby="who-can-use-title">
    <div class="section-heading">
        <h2 id="who-can-use-title">Hvem kan bruke Beredskapssentralen?</h2>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <article class="step-card h-100">
                <h3>Ressursleverandører</h3>
                <p>Privatpersoner, bedrifter og organisasjoner kan dele utstyr, transport eller lokaler. Du bestemmer hva du tilbyr og når det er tilgjengelig.</p>
            </article>
        </div>
        <div class="col-md-6">
            <article class="step-card h-100">
                <h3>Offentlige virksomheter</h3>
                <p>Godkjente offentlige virksomheter kan melde behov og sende forespørsler. Systemansvarlig vurderer søknaden. Etter godkjenning kan virksomhetens administrator invitere ansatte.</p>
            </article>
        </div>
    </div>
</section>

<section class="how-it-works" aria-labelledby="resource-example-title">
    <div class="section-heading">
        <h2 id="resource-example-title">Hva skjer når jeg deler en ressurs?</h2>
    </div>
    <div class="step-card">
        <p>En bedrift registrerer en traktor og oppgir når den kan brukes. Kommunen finner traktoren på kartet og sender en forespørsel. Bedriften svarer, og de avtaler bruken.</p>
        <p class="mt-3">Godkjente offentlige aktører kan se plasseringen og kontaktopplysningene. Andre leverandører ser bare sine egne ressurser.</p>
    </div>
</section>

<section class="how-it-works" aria-labelledby="about-reachout-title">
    <div class="section-heading">
        <h2 id="about-reachout-title">Hvem er vi?</h2>
    </div>
    <p>Beredskapssentralen er et studentprosjekt for lokal beredskap. Vi har laget løsningen for å gjøre det enklere for offentlige virksomheter å finne ressurser i nærmiljøet og avtale hjelp med dem som kan bidra.</p>
    <a asp-controller="Home" asp-action="About">Les mer om Beredskapssentralen</a>
</section>

<section class="how-it-works" aria-labelledby="emergency-title">
    <div class="section-heading">
        <h2 id="emergency-title">Nødnumre og legevakt</h2>
        <p>Ved akutt fare, ring nødetatene direkte. Behov som registreres i Beredskapssentralen, sendes ikke til nødetatene.</p>
    </div>
    <div class="step-grid">
        <article class="step-card">
            <h3><a href="tel:110">110 · Brann</a></h3>
            <p>Ved brann eller akutt behov for brann- og redningstjenesten.</p>
        </article>
        <article class="step-card">
            <h3><a href="tel:112">112 · Politi</a></h3>
            <p>Når du trenger øyeblikkelig hjelp fra politiet.</p>
        </article>
        <article class="step-card">
            <h3><a href="tel:113">113 · Medisinsk nødhjelp</a></h3>
            <p>Ved alvorlig sykdom eller skade som krever akutt helsehjelp.</p>
        </article>
    </div>
    <p class="mt-3">Ring <a href="tel:116117">116 117</a> til legevakten når fastlegen er utilgjengelig og hjelpen ikke kan vente.</p>
    <p><a href="https://nkom.no/telefoni-og-telefonnummer/nodnummer-nodanrop-og-lokalisering">Nødnumre hos Nkom</a> · <a href="https://www.helsenorge.no/hjelpetilbud-i-kommunene/legevakt/">Legevakt på Helsenorge</a></p>
</section>

<section class="how-it-works" aria-labelledby="faq-title">
    <div class="section-heading">
        <h2 id="faq-title">Ofte stilte spørsmål</h2>
    </div>
    <div class="step-card">
        <details>
            <summary class="fw-semibold">Forplikter jeg meg til å låne ut en ressurs når jeg registrerer den?</summary>
            <p class="pb-3">Du velger selv om du vil godta en forespørsel. En reservasjon blir først bekreftet når du godtar, og dere avtaler den praktiske bruken sammen.</p>
        </details>
        <details class="border-top">
            <summary class="fw-semibold">Hvordan får jeg tilgang som offentlig aktør?</summary>
            <p class="pb-3">Hvis virksomheten allerede er godkjent, ber du organisasjonsadministratoren om en invitasjon. Hvis virksomheten trenger tilgang, kan dere <a asp-controller="Organizations" asp-action="Apply">sende en søknad</a>.</p>
        </details>
        <details class="border-top">
            <summary class="fw-semibold">Hvem ser hvor ressursen min står?</summary>
            <p class="pb-3">Du kan se dine egne ressurser. Godkjente offentlige aktører kan også se registrert plassering og kontaktopplysninger.</p>
        </details>
        <details class="border-top">
            <summary class="fw-semibold">Kan jeg bidra med tid eller kompetanse?</summary>
            <p class="pb-3">Ja. Med en leverandørkonto kan du opprette en frivilligprofil og melde interesse for åpne hjelpebehov.</p>
        </details>
    </div>
</section>
