<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Felles Ressurs</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Innlevering1_Gruppe2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">
                        <i class="fa-solid fa-people-group"></i>
                    </span>
                    <span>Felles Ressurs</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Åpne navigasjon">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav main-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Hjem</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Resource" asp-action="Map">Kartet</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Resource" asp-action="Register">Legg til ressurs</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Resource" asp-action="MyResources">Mine ressurser</a>
                            </li>
                        }
                    </ul>

                    <div class="account-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="account-email" title="Innlogget konto">
                                <span class="account-dot" aria-hidden="true"></span>
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                            </span>
                            <form asp-controller="Login" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link logout-button">Logg ut</button>
                            </form>
                        }
                        else
                        {
                            <a class="account-action account-login" asp-controller="Login" asp-action="Index">
                                <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
                                Logg inn
                            </a>
                            <a class="account-action account-register" asp-controller="Login" asp-action="Register">
                                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                                Opprett bruker
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <span>&copy; 2026 Felles Ressurs</span>
            <span>Enklere deling av viktige ressurser</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>