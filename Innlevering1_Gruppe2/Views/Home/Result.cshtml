@* Mottar ressursen controlleren fant ved hjelp av ID-en i forespørselen *@

@model RessursViewModel

@{
    ViewData["Title"] = "Resultat";
}

<div class="result-page">
    <div class="result-card card shadow-sm text-center">
        <div class="card-body">
            <div class="success-icon" aria-hidden="true">
                ✓
            </div>

            <h1 class="h3 mt-3">
                @Model.RessursNavn er registrert
            </h1>

            <p class="text-muted">
                Ressursen er registrert med denne posisjonen:
            </p>

            @* Viser registrerte posisjonen med seks desimaler *@

            <p>
                Latitude: @Model.Latitude.ToString("F6")<br />
                Longitude: @Model.Longitude.ToString("F6")
            </p>

            @*  *@

            <a class="btn btn-primary"
               asp-controller="Home"
               asp-action="Register">
                Registrer en ny ressurs
            </a>

            <a class="btn btn-outline-secondary"
               asp-controller="Home"
               asp-action="Map">
                Se alle ressursene på kartet
            </a>
        </div>
    </div>
</div>