@{
    var requests = ViewBag.PendingRequests is int requestCount ? requestCount : 0;
    var interests = ViewBag.PendingInterests is int interestCount ? interestCount : 0;
}
@if (requests > 0 || interests > 0)
{
    <aside class="pending-tasks" aria-label="Oppgaver som venter på svar">
        <strong><i class="fa-regular fa-bell" aria-hidden="true"></i> Oppfølging</strong>
        @if (requests > 0)
        {
            <a href="/Requests">@requests forespørsler @(User.IsInRole("Private") ? "du må svare på" : "venter på svar") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        }
        @if (interests > 0)
        {
            <a href="/Interests">@interests @(User.IsInRole("Private") ? "påmeldinger venter på svar" : "frivilligpåmeldinger du må svare på") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        }
    </aside>
}
