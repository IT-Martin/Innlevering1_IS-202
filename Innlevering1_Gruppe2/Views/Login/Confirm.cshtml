@{ ViewData["Title"] = "Bekreft jobbadressen"; }
<div class="management-page">
    <h1>Bekreft jobbadressen</h1>
    <div class="auth-card mx-auto">
        <p>Bekreft jobbadressen for å aktivere den inviterte kontoen.</p>
        <form method="post">
            <input type="hidden" name="token" value="@ViewBag.Token" />
            <button class="btn btn-primary">Bekreft jobbadresse</button>
        </form>
    </div>
</div>
