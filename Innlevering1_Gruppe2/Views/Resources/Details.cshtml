@model ResourceDetailsViewModel
@{
    var resource = Model.Resource;
    ViewData["Title"] = resource.resource_name;
    var canRequest = User.IsInRole("Public") && User.FindFirst("Permission")?.Value != "Lesetilgang"
        && !resource.archived && resource.availability_status != "Ikke tilgjengelig"
        && Model.Periods.Any(period => period.available_to > DateTime.Now);
}
<div class="management-page">
    <p class="eyebrow">Ressursdetaljer</p>
    <h1>@resource.resource_name</h1>
    @if(resource.archived){
    <div class="alert alert-warning">Ressursen er arkivert. Dette er historikk.</div>}
    <section class="card">
        <div class="card-body">
            <span class="resource-type">
                <i class="@Reachout.Models.ResourceTypeIcon.For(resource.ResourceType.category_name, resource.resource_name)">
                </i> @resource.ResourceType.category_name</span>
            <span class="status-pill">@resource.availability_status</span>
            @if (canRequest)
            {
                <p class="mt-3"><a class="btn btn-primary" href="#resource-request">@(Model.Needs.Count > 0 ? "Gå til forespørsel" : "Se hvordan du sender forespørsel")</a></p>
            }
            <h2 class="h5 mt-4">Beskrivelse</h2>
            <p>@(string.IsNullOrWhiteSpace(resource.description) ? "Ingen beskrivelse lagt til." : resource.description)</p>
            @if(resource.image_data != null){
            <img class="resource-photo mb-3" src="/Resources/Photo/@resource.resource_id" alt="Bilde av @resource.resource_name" />}
            <h2 class="h5 mt-4">Plassering</h2>
            <p>@(string.IsNullOrWhiteSpace(resource.Location.address_or_area) ? "Se plasseringen på kartet." : resource.Location.address_or_area)</p>
            <button type="button" class="btn btn-outline-primary mb-3" data-expand-detail-map aria-controls="resource-location-map" aria-expanded="false" hidden>Åpne i større kart</button>
            <div id="resource-location-map" data-detail-map class="map-picker" role="region" aria-label="Ressursens plassering" data-lat="@resource.Location.latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-lng="@resource.Location.longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            </div>
            <h2 class="h5 mt-4">Tilgjengelige perioder</h2>
            @foreach(var period in Model.Periods){
            <p>@period.available_from.ToString("dd.MM.yyyy HH:mm") – @period.available_to.ToString("dd.MM.yyyy HH:mm")</p>}
            @if(Model.Periods.Count == 0){
            <p>Ingen tilgjengelige perioder. Nye forespørsler kan ikke sendes før en periode er lagt til.</p>}
            <h2 class="h5">Kontakt</h2>
            <p>@resource.ProviderAccount.contact_name · @resource.ProviderAccount.phone · @resource.ProviderAccount.Account.email</p>
            <p class="small text-muted">Verifisering: @resource.verification_status</p>
            @if(Model.CanEdit){
            <div class="resource-actions">
                <a class="btn btn-primary" href="/Resources/Edit/@resource.resource_id">Endre ressurs</a>
                <a class="btn btn-outline-primary" href="/Availability/Index/@resource.resource_id">Endre tilgjengelighet</a>
            </div>}
        </div>
    </section>
    <div asp-validation-summary="All" class="text-danger"></div>
    @if(canRequest){
    <section id="resource-request" class="card mt-4">
        <div class="card-body">
            <h2 class="h4">Send forespørsel</h2>
            @if(Model.Needs.Count == 0){
            <p>Du har ingen åpne behov i denne ressursens kategori som kan kobles til en ny forespørsel.</p>
            <a href="/Needs/Create">Meld behov</a>}
            else {
            <form asp-controller="Resources" asp-action="CreateRequest" method="post">
                <input asp-for="Request.ResourceId" type="hidden" />
                <div class="form-grid">
                    <label class="form-label">Mitt behov<select asp-for="Request.NeedId" class="form-select" required>
                            <option value="">Velg et åpent behov</option>
                            @foreach(var need in Model.Needs){
                            <option value="@need.resource_need_id">@need.title</option>}
                        </select>
                        <span asp-validation-for="Request.NeedId" class="text-danger"></span>
                    </label>
                    <label class="form-label">Fra<input asp-for="Request.Start" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" required class="form-control" />
                        <span asp-validation-for="Request.Start" class="text-danger"></span>
                    </label>
                    <label class="form-label">Til<input asp-for="Request.End" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" required class="form-control" />
                        <span asp-validation-for="Request.End" class="text-danger"></span>
                    </label>
                </div>
                <label class="form-label d-block">Melding<textarea asp-for="Request.Message" maxlength="2000" class="form-control"></textarea>
                    <span asp-validation-for="Request.Message" class="text-danger"></span>
                </label>
                <button class="btn btn-primary">Send forespørsel</button>
            </form>
            <p class="text-muted mt-2">Ressursen er reservert først når leverandøren godtar. Hvert behov kan kobles til én ressurs. Registrer separate behov hvis du trenger flere ressurser.</p>}
        </div>
    </section>}
    <a class="d-block mt-3" href="/Map">Tilbake til kartet</a>
    @section Scripts {
    <script src="~/lib/leaflet/leaflet.js">
    </script>
    <script src="/js/location-map.js" asp-append-version="true">
    </script>}
</div>
