@{ ViewData["Title"] = "Glemt passord"; }
<div class="management-page">
    <h1>Glemt passord</h1>
    <div class="auth-card mx-auto">
        <p>Oppgi kontoadressen. Hvis kontoen finnes, sendes en personlig lenke.</p>
        <form method="post">
            <div asp-validation-summary="All" class="text-danger">
            </div>
            <label class="form-label">E-post<input name="email" type="email" class="form-control" required />
            </label>
            <button class="btn btn-primary">Send passordlenke</button>
        </form>
        <a href="/Login">Tilbake</a>
    </div>
</div>
