@model OrganizationFormViewModel
@{ ViewData["Title"] = "Søk om organisasjonstilgang"; }
<div class="form-page">
    <h1>Søk om organisasjonstilgang</h1>
    <p>Systemansvarlig kontrollerer organisasjonen. Etter godkjenning inviteres en organisasjonsadministrator, som kan invitere ansatte.</p>
    <form method="post" class="resource-form card">
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger">
            </div>
            <div class="form-grid">
                <label class="form-label">Organisasjonsnavn<input asp-for="Name" class="form-control" />
                </label>
                <label class="form-label">Organisasjonstype<input asp-for="Type" class="form-control" />
                </label>
                <label class="form-label">Organisasjonsnummer<input asp-for="Number" class="form-control" />
                </label>
                <label class="form-label">Jobbdomene<input asp-for="Domain" class="form-control" placeholder="kommune.no" />
                </label>
                <label class="form-label">Kontaktperson<input asp-for="Contact" class="form-control" />
                </label>
                <label class="form-label">Jobbadresse<input asp-for="Email" class="form-control" type="email" />
                </label>
                <label class="form-label">Telefon<input asp-for="Phone" class="form-control" />
                </label>
            </div>
            <button class="btn btn-primary">Send søknad</button>
        </div>
    </form>
</div>
