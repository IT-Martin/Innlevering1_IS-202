<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brannressurser</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Innlevering1_Gruppe2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    🔥 Brannressurser
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Åpne navigasjon">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto">

                        <!-- Felles navigasjon -->

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Hjem
                            </a>
                        </li>

                        <!-- Åpner skjemaet for å registrere en ny ressurs. -->
                        <li class="nav-item">
                            <a class="nav-link"
                                asp-controller="Home"
                                asp-action="Register">
                                Registrer Ressurs
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#"> <!--Midlertidig-->
                                Ressurser
                            </a>
                        </li>

                        <!-- Åpner skjemaet for kartet -->
                        <li class="nav-item">
                            <a class="nav-link" 
                               asp-controller="Home"
                               asp-action="Map">
                                Kartet
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link login-link" href="#">
                                Logg inn
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container py-3 text-center">
            &copy; 2026 - Brannressurser - Gruppe 2
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>