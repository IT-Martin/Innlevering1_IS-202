@* Mottar ressurslisten fra ResourceController.Map().  *@

@model List<RessursViewModel>
@using System.Globalization

@{
    ViewData["Title"] = "Kart";
}

<div class="map-page">
    <div class="map-page-header">
        <div>
            <p class="eyebrow">OVERSIKT</p>
            <h1>Kart over registrerte ressurser</h1>
            <p class="text-muted mb-0">Klikk på en markør for å se navn og koordinater.</p>
        </div>
        <a class="btn btn-primary btn-lg" asp-action="Register">
            Registrer ressurs <span aria-hidden="true">→</span>
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="map-empty-state">
            <strong>Ingen ressurser er registrert ennå.</strong>
            <span>Legg til den første ressursen for å bygge kartet.</span>

            <a asp-action="Register">
                Legg til ressurs
            </a>
        </div>
    }
    else
    {
        <div class="map-summary" role="status">
            <span class="summary-dot" aria-hidden="true"></span>
            <strong>@Model.Count</strong> registrerte ressurser
        </div>
    }

    <div class="map-shell">
        <div id="map" aria-label="Kart over registrerte ressurser">
        </div>
    </div>

    @* Viser ressursene som lenker til resultatsiden.
       data-attributtene gjør navn og koordinater tilgjengelige for JavaScript
    *@

    <div class="resource-list-header">
        <h2>Ressurser i kartet</h2>
        <span>Velg en ressurs for mer informasjon</span>
    </div>

    <ul id="resource-list" class="resource-list">
        @foreach (var ressurs in Model)
        {
            // Razor HTML-koder navn og attributter. JavaScript leser dem via dataset.
            <li class="list-group-item"
                data-latitude="@ressurs.Latitude.ToString(CultureInfo.InvariantCulture)"
                data-longitude="@ressurs.Longitude.ToString(CultureInfo.InvariantCulture)"
                 data-resource-name="@ressurs.RessursNavn"
                 data-type-icon="@ressurs.TypeIcon">

                <a asp-action="Result"
                   asp-route-id="@ressurs.Id">
                    <i class="@ressurs.TypeIcon resource-type-icon" aria-hidden="true"></i>
                    @ressurs.RessursNavn
                </a>
            </li>
        }
    </ul>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        const map = L.map("map").setView([58.1467, 7.9956], 13);

        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                maxZoom: 19,
                attribution: "&copy; OpenStreetMap-bidragsytere"
            }
        ).addTo(map);

        const positions = [];

        document.querySelectorAll("#resource-list [data-latitude]")
            .forEach(element => {
                const latitude = Number.parseFloat(
                    element.dataset.latitude
                );

                const longitude = Number.parseFloat(
                    element.dataset.longitude
                );

                if (!Number.isFinite(latitude)
                    || !Number.isFinite(longitude)) {
                    return;
                }

                const position = [latitude, longitude];
                positions.push(position);

                //Bruker tekstContent slik at ressursdata behandles som tekst og ikke som HTML
                const popup = document.createElement("div");

                const resourceName = document.createElement("strong");
                resourceName.textContent = element.dataset.resourceName;

                const coordinates = document.createElement("div");
                coordinates.textContent =
                    `Latitude: ${latitude.toFixed(6)}, Longitude: ${longitude.toFixed(6)}`;

                popup.append(resourceName, coordinates);

                const markerContent = document.createElement("div");
                markerContent.className = "resource-marker";

                const markerGlyph = document.createElement("i");
                markerGlyph.className = "resource-marker-glyph";
                markerGlyph.setAttribute("aria-hidden", "true");
                markerContent.append(markerGlyph);

                const markerIconClass = element.dataset.typeIcon || "fa-solid fa-location-dot";
                markerGlyph.className = `${markerIconClass} resource-marker-glyph`;

                const markerIcon = L.divIcon({
                    className: "resource-marker-container",
                    html: markerContent.outerHTML,
                    iconSize: [42, 48],
                    iconAnchor: [21, 45],
                    popupAnchor: [0, -42]
                });

                L.marker(position, { icon: markerIcon })
                    .addTo(map)
                    .bindPopup(popup);
            });
            //Sentrerer kartet på valgte ressurs. 
            //Hvis listen er tom, beholdes startutsnittet over Kristiansand
        if (positions.length === 1) {
            map.setView(positions[0], 15);
        } else if (positions.length > 1) {
            map.fitBounds(positions, {
                padding: [30, 30],
                maxZoom: 15
            });
        }
    </script>
}