@{
    ViewData["Title"] = "Registrert ressurs";
}

<div class="container py-5">
    <h1>Ressurs er registrert</h1>

    <p class="text-muted mb-4">
        Informasjonen under viser den registrerte ressursen.
    </p>

    <div class="mb-3">
        <strong>Bruker:</strong>
        <span>@Model.Username</span>
    </div>

    <div class="mb-3">
        <strong>Type ressurs:</strong>
        <span>@Model.ResourceType</span>
    </div>

    <div class="mb-3">
        <strong>Tidspunkt:</strong>
        <span>@Model.DateTime</span>
    </div>

    <div class="mb-3">
        <strong>Kontaktpunkt:</strong>
        <span>@Model.Contact</span>
    </div>

    <div class="mb-3">
        <strong>Latitude:</strong>
        <span>@Model.Latitude</span>
    </div>

    <div class="mb-4">
        <strong>Longitude:</strong>
        <span>@Model.Longitude</span>
    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary">
        Tilbake til forsiden
    </a>
</div>