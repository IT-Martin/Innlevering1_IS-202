@model IReadOnlyList<Reservation>
    @{ ViewData["Title"] = "Forespørsler og reservasjoner"; }
    <div class="management-page">
        <h1>Forespørsler og reservasjoner</h1>
        <p>En forespørsel blir en reservasjon når leverandøren godtar. Avsluttede saker beholdes som historikk.</p>
        <partial name="_StatusTabs" />
            @foreach(var reservation in Model){
            <partial name="_ReservationCard" model="reservation" />}@if(Model.Count == 0){
                <p>Ingen forespørsler med valgt status.</p>}
            </div>
