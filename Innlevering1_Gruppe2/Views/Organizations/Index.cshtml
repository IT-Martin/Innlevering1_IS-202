@model OrganizationAdminViewModel
@{ ViewData["Title"] = Model.Platform ? "Tilgangsadministrasjon" : "Organisasjon og ansatte"; }
<div class="management-page">
    <h1>@ViewData["Title"]</h1>
    <p>@(Model.Platform ? "Kontroller organisasjonen gjennom en uavhengig kanal før du godkjenner og inviterer første administrator." : "Inviter ansatte til egen organisasjon og gi bare tilgangen de trenger.")</p>
    @foreach(var org in Model.Organizations){
    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h4">@org.organization_name</h2>
            <p>@org.organization_number · @org.organization_type · @org.approval_status</p>
            <p>Kontakt: @org.contact_name · @org.contact_email · @org.phone</p>
            <p>@org.verification</p>
            @if(Model.Platform){
            <form asp-action="Review" method="post">
                <input name="id" type="hidden" value="@org.public_organization_id" />
                <div class="form-grid">
                    <label class="form-label">Status<select name="status" class="form-select">
                            <option>Godkjent</option>
                            <option>Sperret</option>
                            <option>Avslått</option>
                        </select>
                    </label>
                    <label class="form-label">Dokumentert kontroll<textarea name="evidence" minlength="15" maxlength="1000" required class="form-control"></textarea>
                    </label>
                </div>
                <button class="btn btn-outline-primary">Lagre vurdering</button>
            </form>}
            @if(org.approval_status == "Godkjent") {
            <details class="mt-3">
                <summary>@(Model.Platform ? "Inviter organisasjonsadministrator eller ansatt" : "Inviter ansatt")</summary>
                <form asp-action="Invite" method="post">
                    <input name="id" type="hidden" value="@org.public_organization_id" />
                    <div class="form-grid">
                        <label class="form-label">Jobbadresse på @org.email_domain<input name="email" type="email" required class="form-control" />
                        </label>
                        <label class="form-label">Tilgang<select name="permission" class="form-select">
                                <option>Beredskapsansatt</option>
                                <option>Lesetilgang</option>
                                <option>Organisasjonsadministrator</option>
                            </select>
                        </label>
                    </div>
                    <p class="text-muted">Beredskapsansatt kan behandle behov og forespørsler. Lesetilgang gir ingen endringsrett. Organisasjonsadministrator kan i tillegg administrere ansatte.</p>
                    <button class="btn btn-primary">Send personlig invitasjon</button>
                </form>
            </details>}
        </div>
    </section>}
    <h2 class="h4">Ansatte</h2>
    @foreach(var member in Model.Members){
    <section class="card mb-3">
        <div class="card-body">
            <h3 class="h5">@member.Account.contact_name</h3>
            <p>@member.Account.email · @member.PublicOrganization.organization_name · @(member.Account.access_revoked ? "Sperret" : !member.Account.email_confirmed ? "E-postbekreftelse gjenstår" : "Aktiv")</p>
            <form asp-action="Member" method="post">
                <input name="id" value="@member.account_id" type="hidden" />
                <label class="form-label">Tilgang<select name="permission" class="form-select">
                        @foreach(var permission in new[]{"Beredskapsansatt","Lesetilgang","Organisasjonsadministrator"}){
                        <option selected="@(permission == member.permission)">@permission</option>}
                    </select>
                </label>
                <label class="form-check-label mx-3">
                    <input name="revoked" type="checkbox" value="true" checked="@member.Account.access_revoked" /> Fjern tilgang</label>
                <button class="btn btn-outline-primary">Oppdater ansatt</button>
            </form>
        </div>
    </section>}
    <h2 class="h4">Invitasjoner</h2>
    @foreach(var invite in Model.Invitations){
    <section class="card mb-2">
        <div class="card-body">
            <p>@invite.email · @invite.permission · @(invite.revoked ? "Sperret" : invite.used_at.HasValue ? "Brukt" : invite.expires_at < DateTime.UtcNow ? "Utløpt" : "Venter på aktivering")</p>
            @if(!invite.revoked && !invite.used_at.HasValue){
            <form asp-action="RevokeInvitation" method="post">
                <input name="id" value="@invite.invitation_id" type="hidden" />
                <button class="btn btn-outline-danger">Sperr invitasjon</button>
            </form>}
        </div>
    </section>}
    <details class="mt-4">
        <summary>Siste hendelser</summary>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Tid</th>
                        <th>Konto</th>
                        <th>Handling</th>
                        <th>Referanse</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var entry in Model.Audit){
                    <tr>
                        <td>@entry.occurred_at.ToLocalTime().ToString("dd.MM HH:mm")</td>
                        <td>@entry.account_id</td>
                        <td>@entry.action</td>
                        <td>@entry.target</td>
                    </tr>}
                </tbody>
            </table>
        </div>
    </details>
</div>
