@model NeedFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Meld behov" : "Rediger behov";
}
<div class="form-page">
    <p class="eyebrow">MINE BEHOV</p>
    <h1>@ViewData["Title"]</h1>
    <p class="text-muted">Beskriv hva du trenger, hvor det trengs og i hvilket tidsrom.</p>
    <form asp-action="Save" method="post" class="resource-form card">
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="Id" type="hidden" />
            <fieldset class="form-section">
                <legend>Om behovet</legend>
                <label class="form-label d-block">Behovstittel<input asp-for="Title" class="form-control" placeholder="For eksempel strøm til samlingspunkt" /></label>
                <div class="form-grid period-fields">
                    <label class="form-label">Kategori<select asp-for="ResourceTypeId" class="form-select"><option value="">Velg kategori</option>
                        @foreach (var type in Model.Types)
                        {
                            <option value="@type.resource_type_id">@type.category_name</option>
                        }
                    </select></label>
                    <label class="form-label">Prioritet<select asp-for="Priority" class="form-select"><option>Normal</option><option>Haster</option><option>Planlagt</option></select></label>
                </div>
                <label class="form-label d-block">Beskrivelse<textarea asp-for="Description" class="form-control" rows="4" placeholder="Hva skal ressursen brukes til?"></textarea></label>
            </fieldset>
            <fieldset class="form-section">
                <legend>Plassering</legend>
                <label class="form-label d-block">Adresse eller område<input asp-for="Address" class="form-control" /></label>
                <partial name="_LocationPicker" />
                <input asp-for="Latitude" type="hidden" data-latitude />
                <input asp-for="Longitude" type="hidden" data-longitude />
            </fieldset>
            <fieldset class="form-section">
                <legend>Tidsrom</legend>
                <p class="field-help">Angi perioden du trenger hjelp. Alle tidspunkter er norsk tid.</p>
                <div class="form-grid period-fields">
                    <label class="form-label">Fra<input asp-for="Start" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /></label>
                    <label class="form-label">Til<input asp-for="End" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /></label>
                </div>
                <label class="form-label d-block">Svarfrist (valgfritt)<input asp-for="Deadline" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /></label>
            </fieldset>
            <div class="form-actions">
                <button class="btn btn-primary">@(Model.Id == 0 ? "Meld behov" : "Lagre endringer")</button>
                <a href="/Needs" class="btn btn-light">Avbryt</a>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="/js/location-map.js" asp-append-version="true"></script>
}
